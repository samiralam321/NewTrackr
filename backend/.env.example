# ==============================================================================
# Trackr Backend Environment Variables
# ==============================================================================

# Project & Environment
PROJECT_NAME="Trackr API"
VERSION="2.0.0"
ENVIRONMENT="development" # development | production

# Security & JWT Tokens
SECRET_KEY="generate-a-32-byte-hex-random-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_MINUTES=86400

# PostgreSQL Connection (asyncpg driver required for SQLAlchemy 2 async)
# Example local docker: postgresql+asyncpg://postgres:postgres@localhost:5432/trackr
# Example Supabase pooled: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trackr"

# Redis Connection (Pub/Sub, Heartbeat Presence, WebSocket Gateway)
# Example local: redis://localhost:6379/0
REDIS_URL="redis://localhost:6379/0"

# Supabase Interoperability (Storage & Legacy Token Validation)
NEXT_PUBLIC_SUPABASE_URL="https://bsqqdfkdycziocmgiani.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# WebRTC STUN/TURN Configuration (Optional - Google public STUN used by default)
TURN_URL="turn:turn.yourdomain.com:3478"
TURN_USERNAME="trackr"
TURN_CREDENTIAL="your-turn-secret-credential"
