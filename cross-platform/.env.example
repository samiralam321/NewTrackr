# ==============================================================================
# Trackr Universal Mobile/Web (Expo) Environment Variables
# ==============================================================================

# REST API Base URL (FastAPI backend)
# Local development on emulator/web: http://localhost:8000
# Android emulator loopback: http://10.0.2.2:8000
# Production: https://api.trackr.app
EXPO_PUBLIC_API_URL="http://localhost:8000"

# WebSocket Gateway URL
# Local development: ws://localhost:8000/ws
# Android emulator loopback: ws://10.0.2.2:8000/ws
# Production: wss://api.trackr.app/ws
EXPO_PUBLIC_WS_URL="ws://localhost:8000/ws"

# Supabase Storage & Legacy Auth interoperability
EXPO_PUBLIC_SUPABASE_URL="https://bsqqdfkdycziocmgiani.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
